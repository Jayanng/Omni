# Copy to .env and fill in. Never commit the real file.
#
# Create a Bitget DEMO API key: Settings -> API Management -> Demo API Key.
# Bitget's demo service is a paper environment, so no real funds are involved.

# Bitget demo credentials (Omni injects these into the Agent Hub CLI child process)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# LLM decision layer. Any OpenAI-compatible chat completions endpoint works.
OMNI_LLM_BASE_URL=https://api.gmi-serving.com/v1
OMNI_LLM_API_KEY=
OMNI_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
OMNI_LLM_FALLBACK_MODEL=zai-org/GLM-5.3-Flash

# Optional overrides
# OMNI_BGC=bgc
# OMNI_LOG_DIR=logs
# OMNI_TIMEOUT=30

# Risk inputs. These are policy/behaviour declarations, not market data:
# the venue publishes the collateral haircut and the maintenance-margin ladder,
# and the scenario shocks are derived from realised candle history, so none of
# the values below are market assumptions. Set them only to override policy.
# OMNI_RISK_THRESHOLD_USDT=250
# OMNI_RISK_BUDGET_PCT=0.10
# OMNI_POLICY_MAX_HEDGE_NOTIONAL=5000
